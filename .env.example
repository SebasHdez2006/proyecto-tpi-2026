# Copiar a deploy/env/.env.internet o .env.intranet y ajustar.
# Nunca commitear archivos .env reales.

APP_NAME=tpi115-app
DOMAIN=localhost

# Base de datos
POSTGRES_USER=tpi115
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tpi115
DATABASE_URL=postgresql+psycopg://tpi115:changeme@postgres:5432/tpi115

# Redis (sesiones)
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_SECURE=true

# Identidad (OAuth2/OIDC) — issuer configurable por entorno
# internet: https://accounts.google.com o tenant Auth0/Entra
# intranet: https://keycloak.intranet.local/realms/tpi115
OIDC_ISSUER=https://keycloak.intranet.local/realms/tpi115
OIDC_CLIENT_ID=tpi115-app
OIDC_AUDIENCE=tpi115-app

# Frontend / CDN
# internet: https://cdn.ejemplo.com/tpi115/  (o / para self-hosted)
# intranet: / o https://cdn.intranet.local/tpi115/
CDN_BASE_URL=/
VITE_API_BASE=/api

# CORS — incluir orígenes de los sistemas de otros equipos
CORS_ORIGINS=https://localhost

# Integración entre sistemas (servicio a servicio)
SERVICE_API_KEY=changeme-service-key
EXTERNAL_API_TIMEOUT_SECONDS=5
